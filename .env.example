# Copy to .env and edit. .env is git-ignored: it describes this one machine.

# Every name you will open the page under, comma-separated — the server's
# address on your network, and its hostname if you use one. Anything not
# listed here is refused, which is what protects a page that has no login.
BRAIN_ALLOWED_HOSTS=192.168.1.50,brainbox.local

# Your timezone. The 7am plan and the 1am night shift are both local time.
# Defaults to Europe/Madrid if you leave it out.
TZ=Europe/Madrid

# So the brain writes files as you and not as root. On Linux:
#   echo "UID=$(id -u)" >> .env && echo "GID=$(id -g)" >> .env
# Read from a root shell these come out 0, which builds and runs fine but
# makes every file the brain writes root-owned. Prefer the owner of this
# folder: stat -c '%u %g' .
UID=1000
GID=1000

# The port on the host. The page itself always listens on 7718 inside.
BRAIN_PORT=7718

# Where this folder lives on the server. Running `docker compose` from here
# yourself, the default "." is right and you can leave this alone. Deploying
# through Portainer it is REQUIRED and must be absolute — see docker/PORTAINER.md.
# BRAIN_DIR=/srv/life-brain

# Voice memos, transcribed locally. Off by default — it makes the image about
# three times bigger, and on a small server it runs at roughly real time.
WITH_WHISPER=false
# base is about twice as fast as small, and noticeably rougher.
BRAIN_WHISPER_MODEL=small
OMP_NUM_THREADS=4

# Project folders the brain follows. Mounted read-only; uncomment the matching
# line in docker-compose.yml too.
# PROJECTS_DIR=/home/you/repos
